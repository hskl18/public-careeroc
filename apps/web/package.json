{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run src",
    "e2e": "playwright test",
    "e2e:multi-agent": "playwright test e2e/multi-agent-orchestrator.spec.ts --project=chromium --workers=1",
    "e2e:headed": "playwright test --headed",
    "e2e:auth": "playwright codegen --save-storage=e2e/.auth/user.json http://localhost:3000",
    "e2e:auth:demo": "node scripts/create-demo-storage-state.mjs",
    "gen:api": "openapi-typescript http://localhost:5114/swagger/v1/swagger.json -o src/lib/api-schema.ts",
    "check:api": "openapi-typescript http://localhost:5114/swagger/v1/swagger.json -o /tmp/careeroc-api-schema.check.ts && diff -u src/lib/api-schema.ts /tmp/careeroc-api-schema.check.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@vercel/otel": "2.1.3",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
