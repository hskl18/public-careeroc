# Local development defaults.
# Copy to `.env` and fill only the secrets/features you need.

API_BASE_URL=http://localhost:5114
API_PUBLIC_BASE_URL=http://localhost:5114
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CAREEROC_PROXY_MAX_BODY_BYTES=16777216
AUTH_URL=http://localhost:3000

# Auth / API signing. Development falls back to fixed local values; generate random ones
# (openssl rand -hex 32) for anything other people can reach.
AUTH_SECRET=
CAREEROC_API_AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Access control. Keep allow-all true for open local development.
ACCESS_ALLOWED_EMAILS=
ACCESS_ALLOWED_DOMAINS=
ACCESS_ALLOW_ALL_USERS=true
ADMIN_EMAILS=

# Demo mode. "Open the live demo" signs each visitor into a private workspace built from a
# fictional inbox, so the app runs without Google OAuth. Set both to true together.
DEMO_MODE=false
Demo__Enabled=false

# Local Docker Postgres.
Security__MaxRequestBodyBytes=16777216
ConnectionStrings__Careeroc=Host=localhost;Port=5432;Database=careeroc;Username=postgres;Password=postgres
# A postgresql:// URL is also accepted as DATABASE_URL.
DATABASE_URL=

# Optional LLM extraction. Disabled until `Ollama__ApiKey` is set.
Ollama__Enabled=false
Ollama__BaseUrl=https://ollama.com
Ollama__Model=gemma4:31b-cloud
Ollama__ApiKey=
Ollama__TimeoutSeconds=90
Ollama__MinimumConfidence=0.60
Ollama__PromptTokenCostUsdPer1K=
Ollama__CompletionTokenCostUsdPer1K=
Ollama__GuidanceFilePath=docs/agent-memory/recruiting-email-playbook.md
Ollama__GuidanceMaxCharacters=16000
# Learning from your corrections writes one file shared by everyone on the install, so it is on
# only in Development. Set a path here only for a single-user install.
# Ollama__UserFeedbackFilePath=.careeroc/recruiting-email-feedback.md

# LangGraph multi-agent runtime. scripts/dev-up.sh enables it with a local shared secret.
# The API waits TimeoutSeconds; the runtime stops a review earlier (CAREEROC_AGENT_RUN_TIMEOUT_SECONDS, 100).
AgentRuntime__Enabled=false
AgentRuntime__BaseUrl=http://localhost:8123
AgentRuntime__SharedSecret=
AgentRuntime__TimeoutSeconds=120
# The runtime's evidence-gate threshold, passed through by docker-compose.yml.
AgentRuntime__MinimumConfidence=0.65
AGENT_RUNTIME_PORT=8123

# Gmail OAuth. Register http://localhost:3000/api/inbox-accounts/gmail/oauth/callback as a redirect URI.
Google__ClientId=
Google__ClientSecret=

# Consolidated API background loop.
SyncWorker__Enabled=true
SyncWorker__IntervalSeconds=300
SyncWorker__RunOnStartup=false

# Dashboard freshness. Set ResponseCacheSeconds=0 only when debugging read-model changes.
Dashboard__InboxCheckCacheSeconds=300
Dashboard__ResponseCacheSeconds=20

# Queue recovery. The default is 10 minutes; keep production near this unless
# model providers regularly exceed it.
EmailProcessing__ProcessingLockTimeoutSeconds=600

# API rate limiting.
Security__RateLimiting__UserPermitLimit=120
Security__RateLimiting__AnonymousPermitLimit=30
Security__RateLimiting__OAuthCallbackPermitLimit=20
Security__RateLimiting__WindowSeconds=60
Security__RateLimiting__QueueLimit=0
